DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Redis compartilhado (cache/fila). O prefixo "carestia:" é aplicado no cliente
# (src/lib/redis.ts), não aqui. Inclua a senha na URL: redis://:SENHA@HOST:PORT
REDIS_URL="redis://127.0.0.1:6379"

AUTH_SECRET="troque-por-um-segredo-aleatorio-de-32-bytes"

# Beta fechado por padrão: sem "true", os links de "Criar conta" somem e
# POST /api/auth/register responde 403.
REGISTRATION_OPEN=""

# Admin criado/atualizado pelo `pnpm db:seed` (só o seed lê estas variáveis).
# Senha com ao menos 12 caracteres. Sem as três, o seed cria só as categorias.
ADMIN_NAME=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Quantos proxies anexam IP ao X-Forwarded-For na frente do app (padrão 1:
# Vercel/nginx). Use 2 atrás de Cloudflare + nginx. Define o IP do rate limit.
# TRUST_PROXY_HOPS="1"

# O papel de admin vem da coluna `users.type` ('admin' | 'user'), definida pelo
# seed (prisma/seed.ts). Só admin usa a tela "Importar por chave" (em lote),
# "Categorizar com IA" e a exclusão/mesclagem do catálogo global.

# Consulta de nota por chave (PAGA). Além da tela em lote do admin, habilita o
# QR code da NFC-e no Scanner para qualquer usuário logado — com cota diária por
# usuário e teto global (ver src/app/api/invoices/import-key/route.ts).
INFOSIMPLES_TOKEN=""

# IA (PAGA). Além de "Categorizar com IA" (admin), habilita a leitura de etiqueta
# por foto no Scanner para qualquer usuário logado — com cota diária por usuário
# e teto global (ver src/app/api/labels/read/route.ts).
OPENAI_API_KEY=""
